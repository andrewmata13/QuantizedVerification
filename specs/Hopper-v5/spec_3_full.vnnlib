; Hopper-v5 Spec 3 – Tight latent separation spec (calibrate after training)
;
; This spec checks that for a *small* nominal observation box around a known
; good trajectory point, the encoder output Y_0 is positive (assuming positive
; latent values correspond to healthy behavior after calibration).
;
; Workflow:
;   1. Train model with train_custom_sb3.py
;   2. Run generate_hopper_specs.py to find the median latent value at healthy
;      states, then update the threshold below.
;   3. Verify with verify_hopper.py
;
; The threshold below (0.0) is a placeholder – update it with the actual
; value observed from generate_hopper_specs.py after training.
;
; Input bounds are in *normalized* observation space.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)
(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)

; Violation: any pre-tanh action < -50 (same input box, full network)
(assert (or
    (and (<= Y_0 -50.0))
    (and (<= Y_1 -50.0))
    (and (<= Y_2 -50.0))
))
