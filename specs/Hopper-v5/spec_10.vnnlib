; Hopper-v5 UNSAFE spec — latent3
; Violation: Y_1 >= 6.500000
; Designed to be unsafe for baseline, continuous latent3, and quantized latent3.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)

(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)

(assert (>= X_0  +0.8526))
(assert (<= X_0  +1.4073))
(assert (>= X_1  -0.1500))
(assert (<= X_1  +0.8102))
(assert (>= X_2  -0.0526))
(assert (<= X_2  +0.3462))
(assert (>= X_3  -0.2141))
(assert (<= X_3  +0.8312))
(assert (>= X_4  +0.4043))
(assert (<= X_4  +1.3870))
(assert (>= X_5  +0.6818))
(assert (<= X_5  +0.9805))
(assert (>= X_6  -0.9997))
(assert (<= X_6  -0.2954))
(assert (>= X_7  +0.4342))
(assert (<= X_7  +1.0357))
(assert (>= X_8  -0.9918))
(assert (<= X_8  -0.0006))
(assert (>= X_9  +0.6656))
(assert (<= X_9  +1.4238))
(assert (>= X_10 -0.2452))
(assert (<= X_10 +1.6619))

(assert (or
    (and (>= Y_1 +6.500000))
))
