; Hopper-v5 Spec 1 – Nominal hopping state reachability
;
; Observations (normalized by VecNormalize, indices match Hopper-v5):
;   X_0  : torso z-position (height)         – healthy raw > 0.7
;   X_1  : torso y-rotation (angle)          – healthy raw |angle| < 0.2
;   X_2  : thigh joint angle
;   X_3  : leg joint angle
;   X_4  : foot joint angle
;   X_5  : torso x-velocity (forward)
;   X_6  : torso z-velocity
;   X_7  : torso angular velocity
;   X_8  : thigh angular velocity
;   X_9  : leg angular velocity
;   X_10 : foot angular velocity
;
; Property: for a clearly healthy hopping state (good height, small tilt,
; positive forward velocity) the 1-D encoder bottleneck output Y_0 is bounded.
; This verifies that the encoder correctly maps the nominal operating region
; to a compact latent interval, enabling tractable quantized reachability.
;
; Input bounds are in *normalized* observation space (VecNormalize running stats).
; Typical normalized values for well-visited healthy states lie in [-3, 3].

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)

(declare-const Y_0 Real)

; Input constraints – nominal hopping region (normalized)
; Height: clearly above failure threshold
(assert (>= X_0  0.50))
(assert (<= X_0  2.00))

; Torso angle: upright (small tilt)
(assert (>= X_1 -1.00))
(assert (<= X_1  1.00))

; Joint angles: moderate range
(assert (>= X_2 -2.00))
(assert (<= X_2  2.00))

(assert (>= X_3 -2.00))
(assert (<= X_3  2.00))

(assert (>= X_4 -2.00))
(assert (<= X_4  2.00))

; Forward velocity: positive (hopper moving forward)
(assert (>= X_5  0.00))
(assert (<= X_5  3.00))

; Remaining velocities: moderate
(assert (>= X_6 -2.00))
(assert (<= X_6  2.00))

(assert (>= X_7 -2.00))
(assert (<= X_7  2.00))

(assert (>= X_8 -2.00))
(assert (<= X_8  2.00))

(assert (>= X_9 -2.00))
(assert (<= X_9  2.00))

(assert (>= X_10 -2.00))
(assert (<= X_10  2.00))

; Output constraint: encoder latent is bounded in [-5, 5]
; A SAT result means there exists a nominal input that escapes this range (bad).
; An UNSAT result proves the encoder maps the entire nominal region inside [-5, 5].
(assert (or
    (and (>= Y_0  5.00))
    (and (<= Y_0 -5.00))
))
