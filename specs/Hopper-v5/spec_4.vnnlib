; Hopper-v5 Spec 4 – Non-negativity proof (always UNSAT)
;
; The encoder ends with a ReLU activation: Y_0 = ReLU(linear(...)) ≥ 0.
; This spec verifies that Y_0 < 0 is UNREACHABLE for ANY input in the given
; box, providing a formal proof of the encoder's non-negativity property.
;
; Expected result: UNSAT (property proved in < 1 second)
;   → Demonstrates the verification pipeline is sound for this architecture.
;
; This spec uses a moderately large input box to show the property holds
; globally, not just for a specific point.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)

(declare-const Y_0 Real)

; Nominal operating range (same box as spec_3 – tight, numerically well-conditioned)
; The non-negativity property holds globally but this sub-region is chosen
; to keep the LP well-conditioned for GLPK.
(assert (>= X_0   0.80))
(assert (<= X_0   1.20))

(assert (>= X_1  -0.50))
(assert (<= X_1   0.50))

(assert (>= X_2  -1.00))
(assert (<= X_2   1.00))

(assert (>= X_3  -1.00))
(assert (<= X_3   1.00))

(assert (>= X_4  -1.00))
(assert (<= X_4   1.00))

(assert (>= X_5   0.50))
(assert (<= X_5   2.00))

(assert (>= X_6  -1.00))
(assert (<= X_6   1.00))

(assert (>= X_7  -1.00))
(assert (<= X_7   1.00))

(assert (>= X_8  -1.00))
(assert (<= X_8   1.00))

(assert (>= X_9  -1.00))
(assert (<= X_9   1.00))

(assert (>= X_10 -1.00))
(assert (<= X_10  1.00))

; Output violation: Y_0 is strictly negative (less than -0.01)
; This is UNSAT because the encoder's output layer is ReLU,
; making Y_0 = ReLU(...) ≥ 0 by construction.
; Note: Y_0 = 0 is reachable (when the pre-ReLU is ≤ 0), so we use -0.01 as
; the threshold to prove strict non-negativity is impossible below that level.
(assert (or
    (and (<= Y_0 -0.01))
))
