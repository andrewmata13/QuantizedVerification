; Hopper-v5 Full-network spec (same input box as spec_3)
; Output: 3 Hopper actions in [-1, 1] (after Tanh)
; Violation: any action escapes [-1, 1] – should be UNSAT (proved by Tanh)

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10  Real)
(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)

(assert (>= X_0  0.8000))
(assert (<= X_0  1.2000))
(assert (>= X_1  -0.5000))
(assert (<= X_1  0.5000))
(assert (>= X_2  -1.0000))
(assert (<= X_2  1.0000))
(assert (>= X_3  -1.0000))
(assert (<= X_3  1.0000))
(assert (>= X_4  -1.0000))
(assert (<= X_4  1.0000))
(assert (>= X_5  0.5000))
(assert (<= X_5  2.0000))
(assert (>= X_6  -1.0000))
(assert (<= X_6  1.0000))
(assert (>= X_7  -1.0000))
(assert (<= X_7  1.0000))
(assert (>= X_8  -1.0000))
(assert (<= X_8  1.0000))
(assert (>= X_9  -1.0000))
(assert (<= X_9  1.0000))
(assert (>= X_10  -1.0000))
(assert (<= X_10  1.0000))

; Violation: any action is outside (-1, 1)
; UNSAT proves Tanh keeps all actions in [-1, 1].
(assert (or
    (and (>= Y_0  1.0001))
    (and (<= Y_0 -1.0001))
    (and (>= Y_1  1.0001))
    (and (<= Y_1 -1.0001))
    (and (>= Y_2  1.0001))
    (and (<= Y_2 -1.0001))
))
