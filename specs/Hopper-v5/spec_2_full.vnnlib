; Hopper-v5 Spec 2 – Near-failure (large tilt) state reachability
;
; Property: for states where the torso angle is large (near the ±0.2 rad
; failure boundary, which maps to roughly ±2 in normalized space), the
; 1-D encoder bottleneck output Y_0 is in a DIFFERENT range than the
; nominal hopping region.
;
; This spec is used together with spec_1 to show that the encoder's 1-D
; latent *separates* healthy and near-failure observations, making the
; quantized latent space semantically meaningful for safety verification.
;
; If the verified nominal range from spec_1 is [lo, hi] and the encoder
; output for near-failure states is verifiably OUTSIDE [lo, hi], the
; separation is formally proved.
;
; Input bounds are in *normalized* observation space.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)
(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)

; Violation: any pre-tanh action < -50 (same input box, full network)
(assert (or
    (and (<= Y_0 -50.0))
    (and (<= Y_1 -50.0))
    (and (<= Y_2 -50.0))
))
