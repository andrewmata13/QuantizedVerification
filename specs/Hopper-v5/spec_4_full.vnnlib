; Hopper-v5 Spec 4 – Non-negativity proof (always UNSAT)
;
; The encoder ends with a ReLU activation: Y_0 = ReLU(linear(...)) ≥ 0.
; This spec verifies that Y_0 < 0 is UNREACHABLE for ANY input in the given
; box, providing a formal proof of the encoder's non-negativity property.
;
; Expected result: UNSAT (property proved in < 1 second)
;   → Demonstrates the verification pipeline is sound for this architecture.
;
; This spec uses a moderately large input box to show the property holds
; globally, not just for a specific point.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)
(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)

; Violation: any pre-tanh action < -50 (same input box, full network)
(assert (or
    (and (<= Y_0 -50.0))
    (and (<= Y_1 -50.0))
    (and (<= Y_2 -50.0))
))
