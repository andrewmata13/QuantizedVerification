(assert (<= X_7  -0.022912))
(assert (>= X_8  -3.461248))
(assert (<= X_8  -3.261248))
(assert (>= X_9  +0.024835))
(assert (<= X_9  +0.224835))
(assert (>= X_10  -0.037736))
(assert (<= X_10  +0.162264))
(assert (>= X_11  -0.143548))
(assert (<= X_11  +0.056452))
(assert (>= X_12  -0.051118))
(assert (<= X_12  +0.148882))
(assert (>= X_13  -0.113684))
(assert (<= X_13  +0.086316))
