; Trajectory robustness spec — HalfCheetah-v4 latent2 state 1 step 0 eps=0.1
; Input box : L-inf ball of radius eps=0.1000 around reference obs
; Reference : quantized-controller pre-tanh action at reference obs
; Violation : |Y_j - a_ref_j| > delta=0.6884 for some j
; SAT — violation witnessed within the L-inf box.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
