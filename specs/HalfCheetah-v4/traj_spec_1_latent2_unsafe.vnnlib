(assert (<= X_16  +0.097570))

; Violation: |Y_j - a_ref_j| > delta=0.6884 for any j
(assert (or
    (and (>= Y_0 -0.038699))
    (and (<= Y_0 -1.415526))
    (and (>= Y_1 +0.985501))
    (and (<= Y_1 -0.391326))
    (and (>= Y_2 -0.820559))
    (and (<= Y_2 -2.197386))
    (and (>= Y_3 +1.648930))
    (and (<= Y_3 +0.272102))
    (and (>= Y_4 -0.777312))
    (and (<= Y_4 -2.154140))
    (and (>= Y_5 +1.961519))
    (and (<= Y_5 +0.584691))
))
