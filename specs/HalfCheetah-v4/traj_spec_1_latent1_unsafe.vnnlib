; Trajectory robustness spec — HalfCheetah-v4 state 1 step 0 eps=0.1
; Input box : L-inf ball of radius eps=0.1000 around reference obs
; Reference : quantized-controller pre-tanh action at reference obs
; Violation : |Y_j - a_ref_j| > delta=2.0406 for some j
; SAT — violation witnessed within the L-inf box.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10  Real)
(declare-const X_11  Real)
(declare-const X_12  Real)
(declare-const X_13  Real)
(declare-const X_14  Real)
(declare-const X_15  Real)
(declare-const X_16  Real)
(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)
(declare-const Y_3  Real)
(declare-const Y_4  Real)
(declare-const Y_5  Real)

(assert (>= X_0  +1.415988))
(assert (<= X_0  +1.615988))
(assert (>= X_1  +0.169885))
(assert (<= X_1  +0.369885))
(assert (>= X_2  +0.336739))
(assert (<= X_2  +0.536739))
(assert (>= X_3  -1.142465))
(assert (<= X_3  -0.942464))
(assert (>= X_4  -0.281521))
(assert (<= X_4  -0.081521))
(assert (>= X_5  +0.247105))
(assert (<= X_5  +0.447105))
(assert (>= X_6  +0.072474))
(assert (<= X_6  +0.272474))
(assert (>= X_7  +0.474088))
(assert (<= X_7  +0.674088))
(assert (>= X_8  -3.125144))
(assert (<= X_8  -2.925144))
(assert (>= X_9  +0.080399))
(assert (<= X_9  +0.280399))
(assert (>= X_10  -0.233427))
(assert (<= X_10  -0.033427))
(assert (>= X_11  -0.101176))
(assert (<= X_11  +0.098824))
(assert (>= X_12  -0.088646))
(assert (<= X_12  +0.111354))
(assert (>= X_13  -0.112920))
(assert (<= X_13  +0.087080))
(assert (>= X_14  -0.087451))
(assert (<= X_14  +0.112549))
(assert (>= X_15  -0.133115))
(assert (<= X_15  +0.066885))
(assert (>= X_16  -0.097297))
(assert (<= X_16  +0.102703))

; Violation: |Y_j - a_ref_j| > delta=2.0406 for any j
(assert (or
    (and (>= Y_0 +1.458398))
    (and (<= Y_0 -2.622774))
    (and (>= Y_1 +2.673908))
    (and (<= Y_1 -1.407263))
    (and (>= Y_2 +1.784726))
    (and (<= Y_2 -2.296446))
    (and (>= Y_3 +1.617354))
    (and (<= Y_3 -2.463818))
    (and (>= Y_4 +0.195989))
    (and (<= Y_4 -3.885183))
    (and (>= Y_5 +2.162074))
    (and (<= Y_5 -1.919098))
))
