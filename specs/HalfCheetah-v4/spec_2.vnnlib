; HalfCheetah-v4 Spec 2 — Nominal balanced running: front-shin not fully saturated (lower)
; Input box: p10/p90 of normalized obs during balanced mid-speed running
;   (xvel_norm in [0.5,1.5], |pitch| <= 0.3, |height| <= 0.4).
; Violation: pre-tanh front-shin action Y_4 <= -3.5
;   (observed pre-tanh range ~ [-1.98, 2.13]; threshold well below that).
; SAFE = front-shin never fully saturates downward in this operating region.
; SAT  = some corner of the nominal box maps to extreme negative front-shin torque.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)
(declare-const X_11 Real)
(declare-const X_12 Real)
(declare-const X_13 Real)
(declare-const X_14 Real)
(declare-const X_15 Real)
(declare-const X_16 Real)
(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)
(declare-const Y_3  Real)
(declare-const Y_4  Real)
(declare-const Y_5  Real)

(assert (>= X_0  -0.3175))
(assert (<= X_0  +0.3066))

(assert (>= X_1  -0.2752))
(assert (<= X_1  +0.0660))

(assert (>= X_2  +0.9039))
(assert (<= X_2  +1.7671))

(assert (>= X_3  -1.5614))
(assert (<= X_3  -0.5911))

(assert (>= X_4  +0.2180))
(assert (<= X_4  +1.7572))

(assert (>= X_5  -0.2429))
(assert (<= X_5  +1.2929))

(assert (>= X_6  -0.3191))
(assert (<= X_6  +1.4336))

(assert (>= X_7  -0.8451))
(assert (<= X_7  +0.7590))

(assert (>= X_8  +0.3630))
(assert (<= X_8  +2.3214))

(assert (>= X_9  +0.6737))
(assert (<= X_9  +1.2060))

(assert (>= X_10 -1.4327))
(assert (<= X_10 -0.1190))

(assert (>= X_11 -0.8718))
(assert (<= X_11 +2.2969))

(assert (>= X_12 -1.1248))
(assert (<= X_12 +1.0564))

(assert (>= X_13 +0.4255))
(assert (<= X_13 +1.5402))

(assert (>= X_14 +0.3117))
(assert (<= X_14 +1.9796))

(assert (>= X_15 +0.4235))
(assert (<= X_15 +2.0558))

(assert (>= X_16 +0.8883))
(assert (<= X_16 +1.3336))

; Violation: front-shin pre-tanh action (Y_4) <= -3.5.
; Observed pre-tanh range ~ [-1.98, 2.13] during nominal running.  SAFE expected.
(assert (or
    (and (<= Y_4 -3.5000))
))
