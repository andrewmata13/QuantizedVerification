; Trajectory robustness spec — HalfCheetah-v4, window 5 (steps 490–499), quant_step=0.02
; Input box : bounding box of 17-dim normalized obs window
; Reference : quantized-controller pre-tanh action at box center
; Violation : |Y_j - a_ref_j| > delta=1.9783 for some j
; This spec is SAT — the window itself witnesses the deviation.

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10  Real)
(declare-const X_11  Real)
(declare-const X_12  Real)
(declare-const X_13  Real)
(declare-const X_14  Real)
(declare-const X_15  Real)
(declare-const X_16  Real)
(declare-const Y_0  Real)
(declare-const Y_1  Real)
(declare-const Y_2  Real)
(declare-const Y_3  Real)
(declare-const Y_4  Real)
(declare-const Y_5  Real)

(assert (>= X_0  +0.501359))
(assert (<= X_0  +3.869984))
(assert (>= X_1  -0.503439))
(assert (<= X_1  +0.244180))
(assert (>= X_2  +0.052388))
(assert (<= X_2  +0.425961))
(assert (>= X_3  -0.986084))
(assert (<= X_3  -0.263502))
(assert (>= X_4  -0.182600))
(assert (<= X_4  +0.312176))
(assert (>= X_5  +0.040494))
(assert (<= X_5  +0.417652))
(assert (>= X_6  -0.048006))
(assert (<= X_6  +0.489252))
(assert (>= X_7  +0.069861))
(assert (<= X_7  +0.719353))
(assert (>= X_8  -3.110681))
(assert (<= X_8  -2.926543))
(assert (>= X_9  -0.127967))
(assert (<= X_9  +0.363134))
(assert (>= X_10  -0.096343))
(assert (<= X_10  +0.108357))
(assert (>= X_11  -0.026430))
(assert (<= X_11  +0.018360))
(assert (>= X_12  -0.039287))
(assert (<= X_12  +0.022667))
(assert (>= X_13  -0.021970))
(assert (<= X_13  +0.009326))
(assert (>= X_14  +0.005788))
(assert (<= X_14  +0.042433))
(assert (>= X_15  -0.047662))
(assert (<= X_15  -0.016267))
(assert (>= X_16  -0.073705))
(assert (<= X_16  -0.005599))

; Violation: |Y_j - a_ref_j| > delta=1.9783 for any j
(assert (or
    (and (>= Y_0 +1.800885))
    (and (<= Y_0 -2.155748))
    (and (>= Y_1 +2.887522))
    (and (<= Y_1 -1.069112))
    (and (>= Y_2 +1.925869))
    (and (<= Y_2 -2.030765))
    (and (>= Y_3 +1.604334))
    (and (<= Y_3 -2.352299))
    (and (>= Y_4 +0.298406))
    (and (<= Y_4 -3.658227))
    (and (>= Y_5 +1.672361))
    (and (<= Y_5 -2.284273))
))
