(assert (<= X_15  -0.003799))
(assert (>= X_16  -0.049963))
(assert (<= X_16  -0.019052))

; Violation: |Y_j - a_ref_j| > delta=1.9783 for any j
(assert (or
    (and (>= Y_0 +1.800885))
    (and (<= Y_0 -2.155748))
    (and (>= Y_1 +2.887522))
    (and (<= Y_1 -1.069112))
    (and (>= Y_2 +1.925869))
    (and (<= Y_2 -2.030765))
    (and (>= Y_3 +1.604334))
    (and (<= Y_3 -2.352299))
    (and (>= Y_4 +0.298406))
    (and (<= Y_4 -3.658227))
