(assert (<= X_5  +0.379880))
(assert (>= X_6  -0.025858))
(assert (<= X_6  +0.480310))
(assert (>= X_7  +0.144956))
(assert (<= X_7  +0.657302))
(assert (>= X_8  -3.148007))
(assert (<= X_8  -2.957135))
(assert (>= X_9  -0.021765))
(assert (<= X_9  +0.319935))
(assert (>= X_10  -0.156886))
(assert (<= X_10  +0.093558))
(assert (>= X_11  -0.033196))
(assert (<= X_11  +0.017436))
(assert (>= X_12  -0.027548))
(assert (<= X_12  +0.018665))
(assert (>= X_13  -0.027075))
(assert (<= X_13  +0.015925))
