; Violation: |Y_j - a_ref_j| > delta=2.0406 for any j
(assert (or
    (and (>= Y_0 +1.458398))
    (and (<= Y_0 -2.622774))
    (and (>= Y_1 +2.673908))
    (and (<= Y_1 -1.407263))
    (and (>= Y_2 +1.784726))
    (and (<= Y_2 -2.296446))
