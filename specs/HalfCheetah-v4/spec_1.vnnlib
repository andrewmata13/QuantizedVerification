; HalfCheetah-v4 Spec 1 – Nominal running state reachability
;
; Observations (normalized by VecNormalize, indices match HalfCheetah-v4):
;   X_0  : z-position of torso (height)
;   X_1  : y-rotation of torso (pitch angle)
;   X_2  : x-rotation of torso (roll angle)  -- often excluded but present
;   X_3  : back-thigh joint angle
;   X_4  : back-shin joint angle
;   X_5  : back-foot joint angle
;   X_6  : front-thigh joint angle
;   X_7  : front-shin joint angle
;   X_8  : front-foot joint angle
;   X_9  : x-velocity of torso (forward)
;   X_10 : y-velocity of torso
;   X_11 : z-velocity of torso
;   X_12 : back-thigh angular velocity
;   X_13 : back-shin angular velocity
;   X_14 : back-foot angular velocity
;   X_15 : front-thigh angular velocity
;   X_16 : front-foot angular velocity
;
; Property: for a nominal running state (moderate forward velocity, small
; body tilt, joints in normal range) the 1-D encoder bottleneck Y_0 is bounded.
; Input bounds are in *normalized* observation space (VecNormalize running stats).

(declare-const X_0  Real)
(declare-const X_1  Real)
(declare-const X_2  Real)
(declare-const X_3  Real)
(declare-const X_4  Real)
(declare-const X_5  Real)
(declare-const X_6  Real)
(declare-const X_7  Real)
(declare-const X_8  Real)
(declare-const X_9  Real)
(declare-const X_10 Real)
(declare-const X_11 Real)
(declare-const X_12 Real)
(declare-const X_13 Real)
(declare-const X_14 Real)
(declare-const X_15 Real)
(declare-const X_16 Real)

(declare-const Y_0 Real)

; Torso height: near standing position
(assert (>= X_0  -1.00))
(assert (<= X_0   1.00))

; Torso pitch: small angle (not flipping)
(assert (>= X_1  -1.00))
(assert (<= X_1   1.00))

; Torso roll
(assert (>= X_2  -1.00))
(assert (<= X_2   1.00))

; Joint angles: moderate range
(assert (>= X_3  -2.00))
(assert (<= X_3   2.00))

(assert (>= X_4  -2.00))
(assert (<= X_4   2.00))

(assert (>= X_5  -2.00))
(assert (<= X_5   2.00))

(assert (>= X_6  -2.00))
(assert (<= X_6   2.00))

(assert (>= X_7  -2.00))
(assert (<= X_7   2.00))

(assert (>= X_8  -2.00))
(assert (<= X_8   2.00))

; Forward velocity: positive (running forward)
(assert (>= X_9   0.00))
(assert (<= X_9   3.00))

; Other velocities: moderate
(assert (>= X_10 -2.00))
(assert (<= X_10  2.00))

(assert (>= X_11 -2.00))
(assert (<= X_11  2.00))

(assert (>= X_12 -2.00))
(assert (<= X_12  2.00))

(assert (>= X_13 -2.00))
(assert (<= X_13  2.00))

(assert (>= X_14 -2.00))
(assert (<= X_14  2.00))

(assert (>= X_15 -2.00))
(assert (<= X_15  2.00))

(assert (>= X_16 -2.00))
(assert (<= X_16  2.00))

; Output violation: encoder latent escapes [-5, 5]
; SAT = encoder produces large latent for some nominal input.
; UNSAT = encoder stays within [-5, 5] for the entire nominal box.
(assert (or
    (and (>= Y_0  5.00))
    (and (<= Y_0 -5.00))
))
